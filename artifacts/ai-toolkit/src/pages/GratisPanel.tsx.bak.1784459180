import { useCallback, useEffect, useRef, useState } from "react";

const API = "/api/gratis/admin";
const ADMIN_PW = "yu123456";

// ─── Types ────────────────────────────────────────────────────────────────────
interface Account {
  id: string; email: string; token_hint?: string;
  credits_left: number; credits_initial?: number;
  enabled: boolean; disabled_for_quota: boolean;
  create_time: string; disabled_reason: string | null;
}
interface ProxyEntry {
  url: string; ok: boolean; failed: boolean; failures: number;
  kind: string; last_ok: number; local?: boolean; disabled?: boolean;
}
interface SchedConfig {
  interval_min: number; interval_large_min: number; large_threshold: number;
  count: number; variance_pct: number; break_min: number; cap: number;
}
interface Status {
  ok: boolean;
  pool: { total: number; enabled: number; active: number; occupied: number; total_credits_left: number; mode?: string };
  accounts: Account[];
  maintainer: { running: boolean; enabled: boolean; interval_sec: number; min_pool?: number; threshold?: number; batch?: number; cap: number; gate_locked?: boolean; resume_at?: number };
  sched: { enabled: boolean; running: boolean; paused_cap: boolean; cycles: number; total_ok: number; total_err: number; next_at: number; next_in_sec: number; config: SchedConfig };
  settings: { account_mode: string; has_admin_password: boolean; setup_needed: boolean; active_ref_pool?: string[] };
  proxy_pool: { proxies: ProxyEntry[] };
  apikeys_count: number;
}

// ─── Helpers ──────────────────────────────────────────────────────────────────
function apiFetch(path: string, method = "GET", body?: object) {
  return fetch(`${API}${path}`, {
    method,
    headers: { "Content-Type": "application/json", Authorization: `Bearer ${ADMIN_PW}` },
    body: body !== undefined ? JSON.stringify(body) : undefined,
  }).then(async r => {
    const j = await r.json();
    if (!r.ok && !j.ok) throw new Error(j.error ?? `HTTP ${r.status}`);
    return j;
  });
}

function fmtSec(s: number | undefined) {
  if (!s || s <= 0) return "—";
  const m = Math.floor(s / 60), r = Math.round(s % 60);
  return m > 0 ? `${m}分${r}秒` : `${r}秒`;
}
function fmtTime(ts: number | undefined) {
  if (!ts || ts <= 0) return "—";
  return new Date(ts * 1000).toLocaleString("zh-CN", { month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit" });
}
function fmtNum(n: number | undefined) { return (n ?? 0).toLocaleString(); }

// ─── UI Primitives ────────────────────────────────────────────────────────────
function Stat({ label, value, tone, sub }: { label: string; value: string | number; tone?: "ok"|"warn"|"err"|"dim"; sub?: string }) {
  const color = tone === "ok" ? "text-emerald-400" : tone === "warn" ? "text-amber-400" : tone === "err" ? "text-red-400" : tone === "dim" ? "text-gray-500" : "text-white";
  return (
    <div className="bg-[#0d1117] border border-[#21262d] rounded-lg px-3 py-2">
      <div className="text-[10px] text-gray-500 uppercase tracking-wide">{label}</div>
      <div className={`text-lg font-bold ${color}`}>{value}</div>
      {sub && <div className="text-[10px] text-gray-600">{sub}</div>}
    </div>
  );
}

function Pill({ ok, label }: { ok: boolean; label?: string }) {
  return (
    <span className={`inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full font-medium ${ok ? "bg-emerald-500/15 text-emerald-400" : "bg-gray-500/15 text-gray-500"}`}>
      <span className={`w-1.5 h-1.5 rounded-full ${ok ? "bg-emerald-500" : "bg-gray-600"}`} />
      {label ?? (ok ? "活跃" : "禁用")}
    </span>
  );
}

function Section({ title, icon, badge, defaultOpen = true, action, children }: {
  title: string; icon: string; badge?: React.ReactNode; defaultOpen?: boolean;
  action?: React.ReactNode; children: React.ReactNode;
}) {
  const [open, setOpen] = useState(defaultOpen);
  return (
    <div className="bg-[#161b22] border border-[#21262d] rounded-xl overflow-hidden">
      <div className="flex items-center justify-between px-4 py-3 cursor-pointer select-none hover:bg-[#1c2129]"
        onClick={() => setOpen(v => !v)}>
        <div className="flex items-center gap-2">
          <span>{icon}</span>
          <span className="text-sm font-semibold text-white">{title}</span>
          {badge}
          <svg className={`w-3.5 h-3.5 text-gray-600 transition-transform ml-0.5 ${open ? "rotate-180" : ""}`}
            fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
            <path strokeLinecap="round" strokeLinejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
        <div onClick={e => e.stopPropagation()}>{action}</div>
      </div>
      {open && <div className="px-4 pb-4 pt-1">{children}</div>}
    </div>
  );
}

// ─── Main Component ───────────────────────────────────────────────────────────
export default function GratisPanel() {
  const [status, setStatus] = useState<Status | null>(null);
  const [loading, setLoading] = useState(true);
  const [err, setErr] = useState<string | null>(null);
  const [busy, setBusy] = useState<string | null>(null);
  const [toast, setToast] = useState<{ msg: string; ok: boolean } | null>(null);
  const [search, setSearch] = useState("");
  const [regCount, setRegCount] = useState(1);
  const [newProxy, setNewProxy] = useState("");
  const [proxyFilter, setProxyFilter] = useState<"all"|"ok"|"fail">("all");
  const timerRef = useRef<ReturnType<typeof setInterval> | null>(null);

  const notify = (msg: string, ok = true) => {
    setToast({ msg, ok });
    setTimeout(() => setToast(null), 3000);
  };

  const refresh = useCallback(async () => {
    try {
      const s: Status = await apiFetch("/status");
      setStatus(s); setErr(null);
    } catch (e: any) {
      setErr(e.message);
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    refresh();
    timerRef.current = setInterval(refresh, 30000);
    return () => { if (timerRef.current) clearInterval(timerRef.current); };
  }, [refresh]);

  async function act(path: string, method: string, body?: object, msg?: string) {
    setBusy(path);
    try {
      await apiFetch(path, method, body);
      notify(msg ?? "操作成功");
      await refresh();
    } catch (e: any) {
      notify(e.message, false);
    } finally {
      setBusy(null);
    }
  }

  const accs = status?.accounts ?? [];
  const filtered = accs.filter(a =>
    !search || a.email.toLowerCase().includes(search.toLowerCase()) || a.id.includes(search)
  );
  const p = status?.pool;
  const sc = status?.sched;
  const mt = status?.maintainer;

  const proxies = (status?.proxy_pool?.proxies ?? []).filter(px =>
    proxyFilter === "all" ? true : proxyFilter === "ok" ? px.ok : px.failed
  );

  if (loading) return (
    <div className="flex items-center justify-center py-20 text-gray-500">
      <svg className="animate-spin w-6 h-6 mr-3 text-emerald-500" fill="none" viewBox="0 0 24 24">
        <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4"/>
        <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/>
      </svg>
      正在加载…
    </div>
  );

  if (err && !status) return (
    <div className="flex flex-col items-center justify-center py-20 gap-4">
      <div className="text-red-400 text-center">
        <div className="text-3xl mb-2">⚠️</div>
        <div className="font-semibold">Gratis-Register 离线</div>
        <div className="text-sm text-gray-500 mt-1">{err}</div>
      </div>
      <button onClick={refresh} className="px-4 py-2 bg-emerald-700 hover:bg-emerald-600 rounded-lg text-sm text-white">重试</button>
    </div>
  );

  return (
    <div className="space-y-4 pb-8">
      {toast && (
        <div className={`fixed top-4 right-4 z-50 px-4 py-3 rounded-xl shadow-xl text-sm font-medium transition-all ${toast.ok ? "bg-emerald-900/90 border border-emerald-500/40 text-emerald-300" : "bg-red-900/90 border border-red-500/40 text-red-300"}`}>
          {toast.ok ? "✓ " : "✗ "}{toast.msg}
        </div>
      )}

      {/* Header */}
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-xl font-bold text-white flex items-center gap-2">🆓 Gratis 账号池</h1>
          <p className="text-gray-500 text-sm mt-0.5">
            模式: <span className="text-gray-300">{p?.mode ?? status?.settings.account_mode ?? "—"}</span>
            {status && <> · API Key 数: <span className="text-gray-300">{status.apikeys_count}</span></>}
          </p>
        </div>
        <div className="flex items-center gap-2">
          {err && <span className="text-amber-400 text-xs">⚠ {err}</span>}
          <button onClick={refresh} disabled={!!busy}
            className="p-2 rounded-lg bg-[#21262d] hover:bg-[#30363d] text-gray-400 disabled:opacity-40">
            <svg className={`w-4 h-4 ${busy ? "animate-spin" : ""}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
              <path strokeLinecap="round" strokeLinejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          </button>
        </div>
      </div>

      {/* Stats */}
      <div className="grid grid-cols-4 md:grid-cols-7 gap-2">
        <Stat label="活跃" value={p?.active ?? "—"} tone={p && p.active > 0 ? "ok" : "err"} />
        <Stat label="已启用" value={p?.enabled ?? "—"} />
        <Stat label="总账号" value={p?.total ?? "—"} />
        <Stat label="占用" value={p?.occupied ?? 0} tone={(p?.occupied ?? 0) > 0 ? "warn" : "dim"} />
        <Stat label="剩余积分" value={fmtNum(p?.total_credits_left)} sub="全池合计" />
        <Stat label="注册轮次" value={sc?.cycles ?? 0} sub={`成功 ${sc?.total_ok ?? 0} / 失败 ${sc?.total_err ?? 0}`} />
        <Stat label="下次注册" value={fmtSec(sc?.next_in_sec)} sub={fmtTime(sc?.next_at)} tone="dim" />
      </div>

      {/* Maintainer & Scheduler */}
      <Section title="维护调度" icon="⚙️"
        action={
          <div className="flex gap-2">
            {sc?.running ? (
              <button disabled={!!busy} onClick={() => act("/sched/stop", "POST", {}, "调度已暂停")}
                className="px-3 py-1 bg-amber-600/30 hover:bg-amber-600/50 text-amber-400 rounded-lg text-xs disabled:opacity-40">暂停注册</button>
            ) : (
              <button disabled={!!busy} onClick={() => act("/sched/start", "POST", {}, "调度已启动")}
                className="px-3 py-1 bg-emerald-600/30 hover:bg-emerald-600/50 text-emerald-400 rounded-lg text-xs disabled:opacity-40">启动注册</button>
            )}
          </div>
        }>
        <div className="grid grid-cols-2 md:grid-cols-4 gap-2">
          <div className="bg-[#0d1117] rounded-lg p-3 border border-[#21262d]">
            <div className="text-[10px] text-gray-500 uppercase mb-1">维护线程</div>
            <Pill ok={mt?.running ?? false} label={mt?.running ? "运行中" : "停止"} />
          </div>
          <div className="bg-[#0d1117] rounded-lg p-3 border border-[#21262d]">
            <div className="text-[10px] text-gray-500 uppercase mb-1">注册调度</div>
            <Pill ok={sc?.running ?? false} label={sc?.running ? "运行中" : "暂停"} />
          </div>
          <div className="bg-[#0d1117] rounded-lg p-3 border border-[#21262d]">
            <div className="text-[10px] text-gray-500 uppercase mb-1">池容量上限</div>
            <div className="text-sm text-white">{sc?.config.cap ?? mt?.cap ?? "—"}</div>
          </div>
          <div className="bg-[#0d1117] rounded-lg p-3 border border-[#21262d]">
            <div className="text-[10px] text-gray-500 uppercase mb-1">注册间隔</div>
            <div className="text-sm text-white">{sc?.config.interval_min ?? "—"} 分钟</div>
          </div>
        </div>
      </Section>

      {/* Register Control */}
      <Section title="手动注册" icon="➕" defaultOpen={false}
        action={
          <div className="flex items-center gap-2">
            <label className="text-xs text-gray-500">数量</label>
            <input type="number" min={1} max={20} value={regCount} onChange={e => setRegCount(Number(e.target.value))}
              className="w-16 bg-[#0d1117] border border-[#30363d] rounded px-2 py-1 text-xs text-white" />
            <button disabled={!!busy} onClick={() => act("/accounts/register", "POST", { count: regCount }, `已触发注册 ${regCount} 个账号`)}
              className="px-3 py-1.5 bg-emerald-700 hover:bg-emerald-600 disabled:opacity-40 rounded-lg text-xs text-white font-medium">
              {busy === "/accounts/register" ? "注册中…" : "立即注册"}
            </button>
          </div>
        }>
        <div className="text-xs text-gray-500 py-2">手动注册账号并自动加入账号池。注册完成后账号列表自动刷新。</div>
      </Section>

      {/* Account List */}
      <Section title="账号列表" icon="👤"
        badge={<span className="text-xs text-gray-500 bg-[#21262d] px-2 py-0.5 rounded-full">{filtered.length}</span>}
        action={
          <input value={search} onChange={e => setSearch(e.target.value)} placeholder="搜索邮箱…"
            className="bg-[#0d1117] border border-[#30363d] rounded-lg px-3 py-1 text-xs text-white placeholder-gray-600 w-48 outline-none focus:border-emerald-500" />
        }>
        <div className="overflow-x-auto rounded-lg border border-[#21262d] mt-1">
          <table className="w-full text-xs">
            <thead className="bg-[#0d1117] text-gray-500 sticky top-0">
              <tr>
                <th className="text-left px-3 py-2 font-medium">邮箱</th>
                <th className="text-center px-3 py-2 font-medium">剩余积分</th>
                <th className="text-center px-3 py-2 font-medium">状态</th>
                <th className="text-left px-3 py-2 font-medium">创建时间</th>
                <th className="text-right px-3 py-2 font-medium">操作</th>
              </tr>
            </thead>
            <tbody>
              {filtered.slice(0, 300).map(a => (
                <tr key={a.id} className="border-t border-[#21262d] hover:bg-[#0d1117]/60">
                  <td className="px-3 py-2 text-gray-200 truncate max-w-[220px]" title={a.email}>{a.email}</td>
                  <td className="px-3 py-2 text-center">
                    <span className={a.credits_left <= 0 ? "text-red-400" : a.credits_left <= 200 ? "text-amber-400" : "text-gray-400"}>
                      {fmtNum(a.credits_left)}
                    </span>
                  </td>
                  <td className="px-3 py-2 text-center">
                    {a.disabled_for_quota
                      ? <Pill ok={false} label="耗尽" />
                      : <Pill ok={a.enabled} label={a.enabled ? "活跃" : (a.disabled_reason || "禁用")} />}
                  </td>
                  <td className="px-3 py-2 text-gray-500">{a.create_time?.slice(0, 10) ?? "—"}</td>
                  <td className="px-3 py-2 text-right space-x-2">
                    {a.enabled ? (
                      <button disabled={busy === `/accounts/${a.id}/disable`}
                        onClick={() => act(`/accounts/${a.id}/disable`, "POST", {}, `已禁用 ${a.email}`)}
                        className="text-amber-400 hover:text-amber-300 disabled:opacity-40">禁用</button>
                    ) : (
                      <button disabled={busy === `/accounts/${a.id}/enable`}
                        onClick={() => act(`/accounts/${a.id}/enable`, "POST", {}, `已启用 ${a.email}`)}
                        className="text-emerald-400 hover:text-emerald-300 disabled:opacity-40">启用</button>
                    )}
                    <button disabled={!!busy}
                      onClick={() => { if (confirm(`删除 ${a.email}？`)) act(`/accounts/${a.id}`, "DELETE", undefined, `已删除 ${a.email}`); }}
                      className="text-red-400 hover:text-red-300 disabled:opacity-40">删除</button>
                  </td>
                </tr>
              ))}
              {filtered.length === 0 && <tr><td colSpan={5} className="text-center text-gray-600 py-8">无匹配账号</td></tr>}
            </tbody>
          </table>
        </div>
        {filtered.length > 300 && <p className="text-xs text-gray-600 text-center pt-2">仅显示前 300 条，共 {filtered.length} 条</p>}
      </Section>

      {/* Proxy Pool */}
      <Section title="代理池" icon="🌐" defaultOpen={false}
        badge={<span className="text-xs text-gray-500 bg-[#21262d] px-2 py-0.5 rounded-full">{status?.proxy_pool?.proxies?.length ?? 0}</span>}
        action={
          <div className="flex gap-1">
            {(["all","ok","fail"] as const).map(f => (
              <button key={f} onClick={() => setProxyFilter(f)}
                className={`px-2 py-1 rounded text-xs ${proxyFilter === f ? "bg-blue-600/30 text-blue-400" : "text-gray-500 hover:text-gray-300"}`}>
                {f === "all" ? "全部" : f === "ok" ? "正常" : "失败"}
              </button>
            ))}
          </div>
        }>
        <div className="flex gap-2 mb-3 mt-1">
          <input value={newProxy} onChange={e => setNewProxy(e.target.value)} placeholder="socks5://host:port 或 http://host:port"
            className="flex-1 bg-[#0d1117] border border-[#30363d] rounded-lg px-3 py-1.5 text-xs text-white placeholder-gray-600 outline-none focus:border-blue-500" />
          <button disabled={!newProxy || !!busy} onClick={() => { act("/proxy/add", "POST", { proxy: newProxy }, "已添加代理"); setNewProxy(""); }}
            className="px-3 py-1.5 bg-blue-700 hover:bg-blue-600 disabled:opacity-40 rounded-lg text-xs text-white">添加</button>
        </div>
        <div className="space-y-1 max-h-64 overflow-y-auto">
          {proxies.length === 0
            ? <div className="text-center text-gray-600 py-6 text-xs">无代理</div>
            : proxies.map((px, i) => (
              <div key={i} className="flex items-center justify-between bg-[#0d1117] rounded-lg px-3 py-2 border border-[#21262d]">
                <div className="flex items-center gap-2 min-w-0">
                  <span className={`w-2 h-2 rounded-full flex-shrink-0 ${px.ok ? "bg-emerald-500" : px.failed ? "bg-red-500" : "bg-gray-600"}`} />
                  <span className="text-xs text-gray-300 font-mono truncate">{px.url}</span>
                  <span className="text-[10px] text-gray-600">{px.kind}</span>
                </div>
                <div className="flex items-center gap-3 ml-2 flex-shrink-0">
                  <span className="text-[10px] text-gray-600">失败 {px.failures}</span>
                  <button onClick={() => { if (confirm(`删除 ${px.url}？`)) act(`/proxy/${encodeURIComponent(px.url)}`, "DELETE", undefined, "已删除代理"); }}
                    className="text-red-500 hover:text-red-400 text-xs">✕</button>
                </div>
              </div>
            ))
          }
        </div>
      </Section>
    </div>
  );
}
